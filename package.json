{
    "name": "bumpkg",
    "type": "module",
    "version": "0.0.2",
    "packageManager": "pnpm@10.28.2",
    "description": "",
    "author": "lonewolfyx <olddrivero.king@qq.com>",
    "license": "MIT",
    "homepage": "https://github.com/lonewolfyx/bumpkg",
    "bugs": {
        "url": "https://github.com/lonewolfyx/bumpkg/issues"
    },
    "keywords": [
        "dependencies",
        "devDependencies",
        "optionalDependencies",
        "package.json",
        "update",
        "upgrade",
        "versions",
        "npm",
        "outdated",
        "unused",
        "changelog",
        "updates",
        "cli",
        "updating",
        "updater"
    ],
    "exports": {
        ".": "./dist/index.mjs",
        "./cli": "./dist/cli.mjs",
        "./package.json": "./package.json"
    },
    "bin": {
        "bumpkg": "./bin/cli.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepublishOnly": "pnpm build",
        "prepare": "simple-git-hooks"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "dependencies": {
        "@clack/prompts": "^1.0.0",
        "citty": "^0.2.0",
        "console-table-printer": "^2.15.0",
        "defu": "^6.1.4",
        "find-up": "^8.0.0",
        "glob": "^13.0.1",
        "jiti": "^2.6.1",
        "ofetch": "^1.5.1",
        "yaml": "^2.8.2"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^7.4.2",
        "@lonewolfyx/tsconfig": "^0.0.6",
        "@types/node": "^25.2.2",
        "@types/npm-registry-fetch": "^8.0.9",
        "@types/semver": "^7.7.1",
        "eslint": "^9.39.2",
        "lint-staged": "^16.2.7",
        "npm-registry-fetch": "^19.1.1",
        "picocolors": "^1.1.1",
        "semver": "^7.7.4",
        "simple-git-hooks": "^2.13.1",
        "tsdown": "^0.20.3",
        "tsdown-preset": "^1.0.3",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged",
        "commit-msg": "node scripts/verify-commit.js"
    },
    "lint-staged": {
        "*": "eslint --fix"
    }
}
